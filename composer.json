{
    "name": "kalimeromk/filterable",
    "description": "A Laravel package that simplifies dynamic filtering and searching across models and their relationships, eliminating repetitive query code.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "eloquent",
        "filter",
        "query"
    ],
    "authors": [
        {
            "name": "Zoran Shefot Bogoevski",
            "email": "zbogoevski@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Kalimeromk\\Filterable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kalimeromk\\Filterable\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "rector": "rector process --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kalimeromk\\Filterable\\FilterableServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
